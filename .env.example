API_PORT=8787
VITE_API_BASE=http://localhost:8787
# Keep empty to use the open-source engine CDN in visualiser.html, or point it
# at a self-hosted @8thwall/engine xr.js build.
VITE_EIGHTH_WALL_SCRIPT_URL=
# The open-source engine has no SLAM module. This licensed distributed chunk
# supplies world tracking; replace it with a permitted self-hosted URL if needed.
VITE_EIGHTH_WALL_SLAM_URL=https://cdn.jsdelivr.net/npm/@8thwall/engine-binary@1/dist/xr-slam.js
# Keep provider credentials server-side. The browser only receives capability flags.
EIGHTH_WALL_APP_KEY=
EIGHTH_WALL_TRACKING_MODE=world
# Server-side provider selector. Leave empty to expose the honest
# "awaiting-provider" state instead of fabricating an AI result.
AI_IMAGE_PROVIDER=
# Optional future application storage. Use freshly rotated, least-privilege
# credentials in the deployment secret manager only; never in VITE_* variables.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
