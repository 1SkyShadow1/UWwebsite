{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci && npm run prepare:vercel",
  "outputDirectory": "dist",
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 300,
      "includeFiles": "{server-assets/**,server/certs/**}",
      "excludeFiles": "{.data/**,tmp/**,public/**,dist/**,node_modules/@huggingface/**,node_modules/onnxruntime*/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/handler?__path=:path*" }
  ]
}
